# Short-ish prompt, short reply, modest concurrency - mimics an interactive
# multi-turn chat workload. Good for exercising TTFT/inter-token latency
# panels without pushing the engine into queueing.
#
# Token counts: 512 prompt / 200 output. A single chat turn alone is often
# shorter (NVIDIA GenAI-Perf's generic synthetic chat profile uses ~200/200;
# vLLM's ShareGPT-based benchmark samples average ~150-230 input tokens), but
# real conversational requests carry prior turns as context, which pushes
# input well past a single-turn average - see NVIDIA GenAI-Perf docs and the
# Azure LLM inference trace paper (Patel et al., ISCA 2024, Splitwise).
BENCH_TARGET=http://change-me.change-me-namespace.svc.cluster.local:8000
BENCH_MODEL=change-me
BENCH_TOKENIZER=change-me
BENCH_PROMPT_TOKENS=512
BENCH_OUTPUT_TOKENS=200
BENCH_CONCURRENCY=8
BENCH_MAX_REQUESTS=200
BENCH_MAX_DURATION_SECONDS=180
BENCH_VERIFY_TLS=true
