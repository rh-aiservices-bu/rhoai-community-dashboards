# Short prompt, short reply, modest concurrency - mimics an interactive chat
# workload. Good for exercising TTFT/inter-token latency panels without
# pushing the engine into queueing.
BENCH_TARGET=http://change-me.change-me-namespace.svc.cluster.local:8000
BENCH_MODEL=change-me
BENCH_TOKENIZER=change-me
BENCH_PROMPT_TOKENS=256
BENCH_OUTPUT_TOKENS=128
BENCH_CONCURRENCY=8
BENCH_MAX_REQUESTS=200
BENCH_MAX_DURATION_SECONDS=180
BENCH_VERIFY_TLS=true
