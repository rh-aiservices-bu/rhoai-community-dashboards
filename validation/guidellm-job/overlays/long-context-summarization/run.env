# Long prompt, short reply, low concurrency - mimics summarization/RAG
# workloads. Prefill-heavy, so it's useful for the prefill-vs-decode time
# panel and KV cache utilisation under large contexts.
#
# Token counts: 4096 prompt / 300 output. A RAG stack typically retrieves
# ~5 chunks of ~500-1000 tokens each (common chunking defaults), putting
# realistic retrieved-context input in the 2500-6000+ token range before the
# system prompt/question are even added - plain short-document summarization
# (e.g. MLPerf's Llama task on CNN/DailyMail) averages only ~780 input
# tokens, which is not "long-context". 4096 is a middle-of-the-road choice;
# bump towards 8192+ for a more aggressive RAG/long-document profile.
#
# IMPORTANT: check the target model's actual context window first (see the
# `max_model_len` field returned by `GET <target>/v1/models`). Many small
# open-weight models cap out at 4096 or 8192 tokens total (prompt + output
# combined) - BENCH_PROMPT_TOKENS + BENCH_OUTPUT_TOKENS must stay under that,
# or requests will fail/truncate. Lower BENCH_PROMPT_TOKENS if so.
BENCH_TARGET=http://change-me.change-me-namespace.svc.cluster.local:8000
BENCH_MODEL=change-me
BENCH_TOKENIZER=change-me
BENCH_PROMPT_TOKENS=4096
BENCH_OUTPUT_TOKENS=300
BENCH_CONCURRENCY=4
BENCH_MAX_REQUESTS=80
BENCH_MAX_DURATION_SECONDS=300
BENCH_VERIFY_TLS=true
