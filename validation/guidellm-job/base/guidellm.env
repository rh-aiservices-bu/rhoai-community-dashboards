# Unusable placeholders - every overlay supplies its own run.env overriding
# all of these. Do not edit this file per-run.
BENCH_TARGET=http://change-me.change-me-namespace.svc.cluster.local:8000
BENCH_MODEL=change-me
# Hugging Face repo id of the model actually running on the server - needed
# for local tokenization (prompt/output token counts). Often the same as
# BENCH_MODEL, but not when the server exposes a custom alias instead of the
# upstream HF repo id (e.g. a KServe LLMInferenceService model name).
BENCH_TOKENIZER=change-me
BENCH_PROMPT_TOKENS=256
BENCH_OUTPUT_TOKENS=128
BENCH_CONCURRENCY=10
BENCH_MAX_REQUESTS=100
BENCH_MAX_DURATION_SECONDS=120
BENCH_VERIFY_TLS=true
