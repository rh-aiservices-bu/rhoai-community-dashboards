# Long prompt, short reply, low concurrency - mimics summarization/RAG
# workloads. Prefill-heavy, so it's useful for the prefill-vs-decode time
# panel and KV cache utilisation under large contexts.
BENCH_TARGET=http://change-me.change-me-namespace.svc.cluster.local:8000
BENCH_MODEL=change-me
BENCH_TOKENIZER=change-me
BENCH_PROMPT_TOKENS=2048
BENCH_OUTPUT_TOKENS=256
BENCH_CONCURRENCY=4
BENCH_MAX_REQUESTS=80
BENCH_MAX_DURATION_SECONDS=240
BENCH_VERIFY_TLS=true
